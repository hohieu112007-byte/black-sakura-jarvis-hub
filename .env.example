# Optional: Gemini API key(s) for Tier 3 Cloud fallback (final tier when enabled in Settings)
# You can provide multiple comma-separated backup keys in GEMINI_API_KEYS for automatic 429 quota rotation
GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Custom sandbox directory for exports, context cache, browser profile, and models
# Defaults to C:\AI-Sandbox if present, otherwise ./sandbox inside this repo
# JARVIS_SANDBOX_DIR=

# Optional: Static session token for the local FastAPI backend (auto-generated in backend/.session_token if omitted)
# JARVIS_API_TOKEN=
